# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Local data: never commit sessions, keys, browser profiles or probe dumps
.env
*.session
*.string
*.json.bak
.probe/
logs/
*.log

# Test/cache output
.pytest_cache/
.ruff_cache/
.cache/

# Browser profiles are session credentials (Cloudflare clearance cookies live there).
# Never commit them: they are IP-bound, short-lived and useless to anyone else.
*-profile*/
rz-profile/
browser-profile/
