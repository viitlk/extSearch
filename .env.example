# Where to keep cache and the browser profile (default: ~/.local/share/extsearch)
EXTSEARCH_HOME=~/.local/share/extsearch

# Networking
EXTSEARCH_TIMEOUT=25
EXTSEARCH_MIN_INTERVAL=0.4
EXTSEARCH_CACHE_TTL=300

# Proxies: comma-separated TYPE://IP:PORT (http, https, socks4, socks5)
# EXTSEARCH_PROXIES=socks5://user:pass@1.2.3.4:1080,http://5.6.7.8:3128

# Currency rates used to compare prices between countries (USD per 1 unit, JSON)
# EXTSEARCH_FX={"UAH":0.024,"RUB":0.011}

# MCP server transport: stdio (default) or http
# EXTSEARCH_TRANSPORT=http
# EXTSEARCH_HOST=127.0.0.1
# EXTSEARCH_PORT=8765
